---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinksGrid from '@/components/SocialLinksGrid';
---

<BaseLayout title="About - urmzd">
  <main class="container mx-auto px-4 pt-24 pb-16">
    <div class="mb-8 flex flex-col items-center gap-4">
      <img src="/logo-mark.svg" alt="urmzd logo" class="h-24 w-24 dark:invert" />
      <h1 class="text-4xl font-bold">About Me</h1>
    </div>

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <p>
        For a full introduction, check out my <a href="/blog/welcome">welcome post</a>.
      </p>

      <h2>Get in Touch</h2>
      <SocialLinksGrid client:load />
    </div>
  </main>
</BaseLayout>
