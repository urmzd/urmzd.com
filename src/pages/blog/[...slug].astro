---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import CodeBlockEnhancer from '@/components/CodeBlockEnhancer';
import HeadingLinkEnhancer from '@/components/HeadingLinkEnhancer';
import MobileTOC from '@/components/MobileTOC';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readTime = calculateReadTime(post.body || '');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://urmzd.com';
const postUrl = `${siteUrl}/blog/${post.id}`;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showTOC = tocHeadings.length >= 3;
---

<BaseLayout
  title={`${post.data.title} - urmzd`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
>
  <ArticleLayout
    title={post.data.title}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    readTime={readTime.text}
    tags={post.data.tags}
    shareUrl={postUrl}
    shareText={post.data.shareText}
    body={post.body}
    frontmatter={{
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate.toISOString().split('T')[0],
      updatedDate: post.data.updatedDate?.toISOString().split('T')[0],
      heroImage: post.data.heroImage,
      tags: post.data.tags,
    }}
    slug={post.id}
  >
    {showTOC && (
      <div slot="before-content">
        <MobileTOC client:load headings={tocHeadings} />
      </div>
    )}

    <Content />

    <Fragment slot="enhancers">
      <CodeBlockEnhancer client:idle />
      <HeadingLinkEnhancer client:load />
    </Fragment>
  </ArticleLayout>
</BaseLayout>
