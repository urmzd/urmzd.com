---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectHero from '@/components/ProjectHero';
import ArchitectureFlow from '@/components/ArchitectureFlow';
import TerminalDemo from '@/components/TerminalDemo';
import ImageShowcase from '@/components/ImageShowcase';
import FeatureGrid from '@/components/FeatureGrid';
import TechStackGrid from '@/components/TechStackGrid';
import { projects, getProject } from '@/data/projects';

export function getStaticPaths() {
  return projects
    .filter((p) => p.hasDetailPage)
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect('/projects');
}
---

<BaseLayout title={`${project.title} - urmzd`} description={project.tagline}>
  <main class="pb-16">
    <ProjectHero project={project} client:load />

    <section class="container mx-auto px-4 py-12">
      <h2 class="mb-4 text-2xl font-bold">Overview</h2>
      <p class="max-w-3xl text-muted-foreground leading-relaxed">
        {project.description}
      </p>
    </section>

    {slug === 'resume-generator' && <ArchitectureFlow client:visible />}
    {project.demo?.kind === 'terminal' && <TerminalDemo title={project.demo.title} lines={project.demo.lines} client:visible />}
    {project.demo?.kind === 'image' && <ImageShowcase images={project.demo.images} client:visible />}

    <FeatureGrid features={project.features} client:visible />
    <TechStackGrid tech={project.tech} client:visible />
  </main>
</BaseLayout>
