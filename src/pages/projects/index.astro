---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectExplorer, { type ExplorerProject } from '@/components/ProjectExplorer';
import { categoryFor } from '@/data/projectCategories';

const entries = await getCollection('projects', ({ data }) => data.kind === 'project');

const projects: ExplorerProject[] = entries
  .sort((a, b) => b.data.pushedAt.valueOf() - a.data.pushedAt.valueOf())
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    status: entry.data.status,
    language: entry.data.language,
    image: entry.data.image,
    imageDark: entry.data.imageDark,
    stars: entry.data.stars,
    updated: entry.data.pushedAt.toISOString(),
    category: categoryFor(entry.id, entry.data.topics, entry.data.category),
  }));
---

<BaseLayout title="urmzd | Projects" description="Software projects by urmzd">
  <div class="mx-auto max-w-5xl px-6 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Projects</h1>
    <p class="mb-10 text-muted-foreground">Open-source tools and applications I've built to solve real problems, newest first.</p>

    <ProjectExplorer projects={projects} client:load />
  </div>
</BaseLayout>
