---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard';
import { projects } from '@/data/projects';
---

<BaseLayout title="Projects - urmzd" description="Software projects by urmzd">
  <main class="container mx-auto px-4 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Projects</h1>
    <p class="mb-10 text-muted-foreground">Things I've built and am building.</p>

    <div class="grid gap-6">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} client:visible />
      ))}
    </div>
  </main>
</BaseLayout>
