---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard';
import { projects } from '@/data/projects';
---

<BaseLayout title="Projects - urmzd" description="Software projects by urmzd">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Projects</h1>
    <p class="mb-10 text-muted-foreground">Open-source tools and applications I've built to solve real problems.</p>

    <div class="grid gap-6">
      {projects.map((project, i) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</BaseLayout>
