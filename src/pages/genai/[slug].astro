---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategoryLabel } from '@/lib/skill-categories';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('skills');
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entries = await getCollection('skills');
const entry = entries.find((e) => e.id === slug);

if (!entry) {
  return Astro.redirect('/genai');
}

const { Content } = await render(entry);
const { sourceRepo, sourcePath, rawPath } = entry.data;
const githubUrl = `https://github.com/${sourceRepo}/tree/main/${sourcePath}`;
const rawUrl = `https://raw.githubusercontent.com/${sourceRepo}/main/${rawPath}`;
---

<BaseLayout title={`${entry.data.title} - urmzd`} description={entry.data.description} mdHref={rawUrl}>
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <div class="mb-8">
      <span class="mb-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium text-muted-foreground glass-pill">
        {getCategoryLabel(entry.data.category)}
      </span>
      <h1 class="mt-3 text-4xl font-bold">{entry.data.title}</h1>
      <p class="mt-3 text-muted-foreground">{entry.data.description}</p>
      <div class="mt-4">
        <code class="rounded bg-muted px-2 py-1 text-sm text-muted-foreground">{slug}</code>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-3 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="inline-block" aria-label="GitHub"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>

    <div id="skill-content" data-slug={slug} data-raw-url={rawUrl}>
      <div id="preview-content">
        <article class="prose prose-neutral dark:prose-invert max-w-none">
          <Content />
        </article>
      </div>
      <div id="raw-content" class="hidden">
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initToggle() {
    const container = document.getElementById('skill-content');
    if (!container) return;

    const previewDiv = document.getElementById('preview-content')!;
    const rawDiv = document.getElementById('raw-content')!;

    const toggle = document.createElement('div');
    toggle.className = 'mb-6 flex gap-1 rounded-lg p-1 glass-card w-fit';
    toggle.innerHTML = `
      <button type="button" data-view="preview" class="toggle-btn active inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-colors bg-primary text-primary-foreground">
        Preview
      </button>
      <button type="button" data-view="raw" class="toggle-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:text-foreground">
        Raw
      </button>
    `;
    container.insertBefore(toggle, previewDiv);

    let rawLoaded = false;

    toggle.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-view]') as HTMLElement | null;
      if (!btn) return;

      const view = btn.dataset.view;

      for (const b of toggle.querySelectorAll('.toggle-btn')) {
        if (b === btn) {
          b.className = 'toggle-btn active inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-colors bg-primary text-primary-foreground';
        } else {
          b.className = 'toggle-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:text-foreground';
        }
      }

      if (view === 'preview') {
        previewDiv.classList.remove('hidden');
        rawDiv.classList.add('hidden');
      } else {
        previewDiv.classList.add('hidden');
        rawDiv.classList.remove('hidden');

        if (!rawLoaded) {
          rawDiv.innerHTML = '<p class="text-muted-foreground text-sm">Loading...</p>';
          try {
            const rawUrl = container.dataset.rawUrl!;
            const res = await fetch(rawUrl);
            const text = await res.text();
            rawDiv.innerHTML = `<pre class="overflow-x-auto rounded-xl border border-border bg-muted p-6 text-sm leading-relaxed text-foreground"><code>${escapeHtml(text)}</code></pre>`;
            rawLoaded = true;
          } catch {
            rawDiv.innerHTML = '<p class="text-destructive text-sm">Failed to load raw content.</p>';
          }
        }
      }
    });
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  initToggle();
  document.addEventListener('astro:after-swap', initToggle);
</script>
