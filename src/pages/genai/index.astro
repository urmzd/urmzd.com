---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkillCard from '@/components/SkillCard';
import { getCategoryLabel, type SkillSummary } from '@/lib/skill-categories';
import { getCollection } from 'astro:content';

const entries = await getCollection('skills');
const skills: SkillSummary[] = entries
  .map((e) => ({
    slug: e.id,
    title: e.data.title,
    description: e.data.description,
    category: e.data.category,
    type: e.data.type,
  }))
  .sort((a, b) => a.category.localeCompare(b.category) || a.title.localeCompare(b.title));

const categories = [...new Set(skills.map((s) => s.category))].sort();
---

<BaseLayout title="GenAI - urmzd" description="Agent skills that encode development workflows, conventions, and best practices.">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">GenAI</h1>
    <p class="mb-10 text-muted-foreground">
      Skills and agents I maintain — reusable instruction sets and personas that encode my development workflows, conventions, and best practices.
      Pulled from <a href="https://github.com/urmzd/dotfiles" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">urmzd/dotfiles</a>.
    </p>

    {categories.map((category) => (
      <section class="mb-10">
        <h2 class="mb-4 text-lg font-semibold text-muted-foreground">{getCategoryLabel(category)}</h2>
        <div class="grid gap-4">
          {skills
            .filter((s) => s.category === category)
            .map((skill) => (
              <SkillCard skill={skill} />
            ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
