---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';

const stories = await getCollection('stories');
const sortedStories = stories.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Stories - urmzd">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Stories</h1>
    <p class="mb-10 text-muted-foreground">Short fiction and creative writing exploring ideas through narrative.</p>
    <div class="flex flex-col gap-6">
      {
        sortedStories.map((story) => (
          <article class="group">
            <a
              href={`/stories/${story.id}`}
              class="block rounded-xl p-6 transition-all glass-card hover:border-primary/40"
            >
              <h2 class="text-2xl font-semibold text-foreground group-hover:text-primary">
                {story.data.title}
              </h2>
              <p class="mt-2 line-clamp-3 text-muted-foreground">{story.data.description}</p>
              <div class="mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                <time>
                  {story.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                <span class="hidden sm:inline">|</span>
                <span>{calculateReadTime(story.body || '').text}</span>
              </div>
              {story.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  {story.data.tags.map((tag) => (
                    <span class="glass-pill rounded-full px-2.5 py-0.5 text-xs text-muted-foreground">#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
