---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResearchCard from '@/components/ResearchCard';
import { research } from '@/data/research';
---

<BaseLayout title="Research - urmzd" description="Academic research by urmzd">
  <main class="container mx-auto px-4 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Research</h1>
    <p class="mb-10 text-muted-foreground">Papers and theses.</p>

    <div class="grid gap-6">
      {research.map((item, i) => (
        <ResearchCard item={item} index={i} client:visible />
      ))}
    </div>
  </main>
</BaseLayout>
