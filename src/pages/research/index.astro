---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResearchCard from '@/components/ResearchCard';
import { getCollection } from 'astro:content';

const entries = await getCollection('research');
const sorted = entries.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Research - urmzd" description="Academic research by urmzd">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <h1 class="mb-2 text-4xl font-bold">Research</h1>
    <p class="mb-10 text-muted-foreground">Academic papers and theses exploring machine learning, optimization, and applied mathematics.</p>

    <div class="flex flex-col gap-6">
      {sorted.map((entry, i) => (
        <ResearchCard item={{ ...entry.data, slug: entry.id }} />
      ))}
    </div>
  </div>
</BaseLayout>
